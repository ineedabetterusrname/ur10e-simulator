              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45f7e8</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">Streams Robots plugin Code (URScript) or Grasshopper Planes directly to ~/Desktop/ur10e_sim_live.script for Live Sync in the UR10e Web Simulator.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">a91d2b34-55c1-48f0-9b1e-1029384756ab</item>
                    <item name="Name" type_name="gh_string" type_code="10">UR10e Web Sim Sync</item>
                    <item name="NickName" type_name="gh_string" type_code="10">UR10e Sim Sync</item>
                    <item name="HideInput" type_name="gh_bool" type_code="1">true</item>
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""UR10e Web Simulator — 1-Click Live Sync Node.
Connect EITHER:
  - Code: the 'Code' output from the Robots plugin 'Create Program' component, OR
  - P:    a list of Rhino/GH Planes (TCP targets in robot base coordinates), OR
  - J:    a list of joint strings "j1,j2,j3,j4,j5,j6" in degrees.
Automatically writes ~/Desktop/ur10e_sim_live.script (or .json) whenever your
Grasshopper sliders change. In the Web Simulator, click 'Watch File' and pick
that file on your Desktop for real-time updates!
"""
import os, json, math

out_dir = os.path.expanduser("~/Desktop")
if not os.path.isdir(out_dir):
    out_dir = os.path.expanduser("~")

def flatten_lines(val):
    if val is None:
        return []
    if isinstance(val, (list, tuple)):
        res = []
        for item in val:
            res.extend(flatten_lines(item))
        return res
    return [str(val)]

code_lines = [l for l in flatten_lines( globals().get("Code") ) if l and str(l).strip()]

if code_lines:
    path = F if (globals().get("F") and str(F).strip()) else os.path.join(out_dir, "ur10e_sim_live.script")
    text = "\n".join(code_lines)
    with open(path, "w") as f:
        f.write(text)
    Status = "Synced Robots URScript (%d lines) -> %s" % (len(code_lines), path)
else:
    import Rhino
    scale = Rhino.RhinoMath.UnitScale(
        Rhino.RhinoDoc.ActiveDoc.ModelUnitSystem, Rhino.UnitSystem.Meters)

    def plane_to_pose(pl):
        r = [[pl.XAxis.X, pl.YAxis.X, pl.ZAxis.X],
             [pl.XAxis.Y, pl.YAxis.Y, pl.ZAxis.Y],
             [pl.XAxis.Z, pl.YAxis.Z, pl.ZAxis.Z]]
        tr = r[0][0] + r[1][1] + r[2][2]
        c = max(-1.0, min(1.0, (tr - 1.0) / 2.0))
        ang = math.acos(c)
        if ang &lt; 1e-9:
            rv = [0.0, 0.0, 0.0]
        elif abs(math.pi - ang) &lt; 1e-6:
            ax = [math.sqrt(max(0, (r[i][i] + 1.0) / 2.0)) for i in range(3)]
            i = ax.index(max(ax))
            for j in range(3):
                if j != i and ax[j] &gt; 1e-9:
                    ax[j] = math.copysign(ax[j], r[i][j] + r[j][i])
            n = math.sqrt(sum(a * a for a in ax))
            rv = [a / n * ang for a in ax]
        else:
            s = 2.0 * math.sin(ang)
            rv = [(r[2][1] - r[1][2]) / s * ang,
                  (r[0][2] - r[2][0]) / s * ang,
                  (r[1][0] - r[0][1]) / s * ang]
        return [pl.OriginX * scale, pl.OriginY * scale, pl.OriginZ * scale] + rv

    moves = []
    for txt in (globals().get("J") or []):
        if txt is None: continue
        q = [float(v) for v in str(txt).replace(";", ",").split(",")]
        moves.append({"type": "joints", "q": q[:6], "v": 60})
    for pl in (globals().get("P") or []):
        if pl is None: continue
        moves.append({"type": "pose", "pose": plane_to_pose(pl), "v": 0.25})

    if moves:
        path = F if (globals().get("F") and str(F).strip()) else os.path.join(out_dir, "ur10e_sim_live.json")
        with open(path, "w") as f:
            json.dump({"units": "deg", "moves": moves}, f, indent=1)
        Status = "Synced %d moves -> %s" % (len(moves), path)
    else:
        Status = "Waiting: connect Robots 'Create Program -> Code' to Code, or Planes to P"
</item>
